    "    return ts_arr, df['Bid'].to_numpy(), df['Ask'].to_numpy()\n"
    "\n"
    "\n"
    "def simulate_trade_ticks(direction: str, entry_signal: float,\n"
    "                          levels: dict, ts_arr: np.ndarray,\n"
    "                          bids: np.ndarray, asks: np.ndarray,\n"
    "                          atr: float, ema20_trail=None,\n"
    "                          slippage: float = SLIPPAGE_PTS) -> list:\n"
    "    '''\n"
    "    Simulateur Tick v2.0 — 3 positions (P1/P2/P3)\n"
    "    [FIX-1] Limit Pullback : attend entry_signal +/- ATR*0.5\n"
    "    [FIX-2] BE inconditionnel sur P2/P3 dès TP1 touché\n"
    "    [FIX-3] Time-Stop 45min si TP1 non atteint\n"
    "    '''\n"
    "    if len(bids) == 0:\n"
    "        return []\n"
    "    if asks[0] - bids[0] > MAX_SPREAD:\n"
    "        return []\n"
    "\n"
    "    # ── [FIX-1] Calcul du prix limite ────────────────────────────\n"
    "    if direction == 'BUY':\n"
    "        limit_px   = round(entry_signal - atr * LIMIT_OFFSET_MULT, 2)\n"
    "        exec_check = asks   # BUY : on surveille les asks\n"
    "        exec_px    = bids   # PnL calculé sur bid\n"
    "    else:\n"
    "        limit_px   = round(entry_signal + atr * LIMIT_OFFSET_MULT, 2)\n"
    "        exec_check = bids   # SELL : on surveille les bids\n"
    "        exec_px    = asks\n"
    "\n"
    "    # Chercher le premier tick où le limit est touché (fenêtre 15 min)\n"
    "    limit_idx   = None\n"
    "    limit_cutoff = ts_arr[0] + LIMIT_TIMEOUT_SECS\n"
    "    for k in range(len(exec_check)):\n"
    "        if ts_arr[k] > limit_cutoff:\n"
    "            break\n"
    "        if direction == 'BUY'  and exec_check[k] <= limit_px:\n"
    "            limit_idx = k; break\n"
    "        elif direction == 'SELL' and exec_check[k] >= limit_px:\n"
    "            limit_idx = k; break\n"
    "\n"
    "    if limit_idx is None:\n"
    "        return []   # Limit non touchée dans la fenêtre → pas de trade\n"
    "\n"
    "    # Entry réelle = limit_px ± slippage\n"
    "    entry  = round(limit_px + slippage if direction == 'BUY'\n"
    "                   else limit_px - slippage, 2)\n"
    "    delta  = entry - entry_signal  # pour ajuster TP/SL\n"
    "\n"
    "    sl_init = round(levels['sl']  + delta, 2)\n"
    "    tp1     = round(levels['tp1'] + delta, 2)\n"
    "    tp2     = round(levels['tp2'] + delta, 2)\n"
    "\n"
    "    positions = [\n"
    "        {'id':'P1','tp':tp1, 'sl':sl_init,'result':None,'exit_px':None,\n"
    "         'pnl':0.,'closed':False,'entry_real':entry,\n"
    "         'slippage':round(slippage, 4),'mfe':0.,'mae':0.},\n"
    "        {'id':'P2','tp':tp2, 'sl':sl_init,'result':None,'exit_px':None,\n"
    "         'pnl':0.,'closed':False,'entry_real':entry,\n"
    "         'slippage':round(slippage, 4),'mfe':0.,'mae':0.},\n"
    "        {'id':'P3','tp':None,'sl':sl_init,'result':None,'exit_px':None,\n"
    "         'pnl':0.,'closed':False,'entry_real':entry,\n"
    "         'slippage':round(slippage, 4),'mfe':0.,'mae':0.,'trailing':False},\n"
    "    ]\n"
    "\n"
    "    tp1_hit = tp2_hit = False\n"
    "    start_ts = ts_arr[limit_idx]  # référence Time-Stop\n"
    "\n"
    "    for k in range(limit_idx, len(exec_px)):\n"
    "        if all(p['closed'] for p in positions):\n"
    "            break\n"
    "\n"
    "        px      = exec_px[k]\n"
    "        elapsed = ts_arr[k] - start_ts\n"
    "\n"
    "        # ── [FIX-3] Time-Stop 45 min ─────────────────────────────\n"
    "        if elapsed > TIME_STOP_SECS and not tp1_hit:\n"
    "            for p in positions:\n"
    "                if not p['closed']:\n"
    "                    pts = (px - entry) if direction == 'BUY' else (entry - px)\n"
    "                    p['result']  = 'TIME_STOP'\n"
    "                    p['exit_px'] = round(px, 2)\n"
    "                    p['pnl']     = round(pts * PNL_PER_POINT, 2)\n"
    "                    p['closed']  = True\n"
    "            break\n"
    "\n"
    "        # MFE / MAE\n"
    "        for p in positions:\n"
    "            if not p['closed']:\n"
    "                exc = (px - entry) if direction == 'BUY' else (entry - px)\n"
    "                p['mfe'] = max(p['mfe'], exc)\n"
    "                p['mae'] = min(p['mae'], exc)\n"
    "\n"
    "        # Trailing P3\n"
    "        p3 = positions[2]\n"
    "        if not p3['closed'] and p3['trailing']:\n"
    "            if ema20_trail is not None and len(ema20_trail) > 0:\n"
    "                trail_level = ema20_trail[min(k - limit_idx,\n"
    "                                              len(ema20_trail) - 1)]\n"
    "            else:\n"
    "                trail_level = (px - atr * TRAIL_ATR_MULT if direction == 'BUY'\n"
    "                               else px + atr * TRAIL_ATR_MULT)\n"
    "            new_sl = round(trail_level - atr * 0.1 if direction == 'BUY'\n"
    "                           else trail_level + atr * 0.1, 2)\n"
    "            if direction == 'BUY'  and new_sl > p3['sl']: p3['sl'] = new_sl\n"
    "            if direction == 'SELL' and new_sl < p3['sl']: p3['sl'] = new_sl\n"
    "\n"
    "        for p in positions:\n"
    "            if p['closed']:\n"
    "                continue\n"
    "\n"
    "            # P3 en mode trailing : seul le SL compte\n"
    "            if p['id'] == 'P3' and p['trailing']:\n"
    "                sl_h = (px <= p['sl']) if direction == 'BUY' else (px >= p['sl'])\n"
    "                if sl_h:\n"
    "                    p['closed']  = True\n"
    "                    p['exit_px'] = p['sl']\n"
    "                    rpts = ((p['sl'] - entry) if direction == 'BUY'\n"
    "                            else (entry - p['sl']))\n"
    "                    p['result'] = 'TRAIL_CLOSE' if rpts > 0 else 'SL'\n"
    "                    p['pnl']    = round(rpts * PNL_PER_POINT, 2)\n"
    "                continue\n"
    "\n"
    "            # [FIX-5] TP check sécurisé (tp_v peut être None pour P3)\n"
    "            tp_v = p['tp']\n"
    "            th = ((px >= tp_v) if direction == 'BUY' else (px <= tp_v)) \\\n"
    "                 if tp_v is not None else False\n"
    "            sh = (px <= p['sl']) if direction == 'BUY' else (px >= p['sl'])\n"
    "\n"
    "            # Résolution conflits TP/SL sur même tick\n"
    "            if th and sh and tp_v is not None:\n"
    "                th = abs(tp_v - entry) < abs(p['sl'] - entry)\n"
    "                sh = not th\n"
    "\n"
    "            if th:\n"
    "                p['closed']  = True\n"
    "                p['exit_px'] = tp_v\n"
    "                pts = (tp_v - entry) if direction == 'BUY' else (entry - tp_v)\n"
    "                p['result'] = p['id'].replace('P', 'TP')\n"
    "                p['pnl']    = round(pts * PNL_PER_POINT, 2)\n"
    "\n"
    "                if p['id'] == 'P1' and not tp1_hit:\n"
    "                    tp1_hit = True\n"
    "                    # ── [FIX-2] BREAKEVEN INCONDITIONNEL ─────────\n"
    "                    for o in positions:\n"
    "                        if not o['closed']:\n"
    "                            o['sl'] = entry   # ← INCONDITIONNEL (aucun test)\n"
    "\n"
    "                if p['id'] == 'P2' and not tp2_hit and tp1_hit:\n"
    "                    tp2_hit = True\n"
    "                    if not positions[2]['closed']:\n"
    "                        positions[2]['trailing'] = True\n"
    "                        # SL initial trailing = 25% entre TP1 et TP2\n"
    "                        positions[2]['sl'] = (\n"
    "                            round(tp1 + (tp2 - tp1) * 0.25, 2)\n"
    "                            if direction == 'BUY'\n"
    "                            else round(tp1 - (tp1 - tp2) * 0.25, 2)\n"
    "                        )\n"
    "\n"
    "            elif sh:\n"
    "                p['closed']  = True\n"
    "                p['exit_px'] = p['sl']\n"
    "                pts   = abs(entry - p['sl'])\n"
    "                is_be = abs(p['sl'] - entry) < 0.5\n"
    "                p['result'] = 'BE' if is_be else 'SL'\n"
    "                p['pnl']    = 0. if is_be else round(-pts * PNL_PER_POINT, 2)\n"
    "\n"
    "    # Force-close positions encore ouvertes (fin données)\n"
    "    last_px = exec_px[-1]\n"
    "    for p in positions:\n"
    "        if not p['closed']:\n"
    "            pts = (last_px - entry) if direction == 'BUY' else (entry - last_px)\n"
    "            p['result']  = 'OPEN_END'\n"
    "            p['exit_px'] = last_px\n"
    "            p['pnl']     = round(pts * PNL_PER_POINT, 2)\n"
    "            p['closed']  = True\n"
    "\n"
    "    return positions\n"
    "\n"
    "print('✅ Fetch ticks v2.0 + Simulateur [FIX-1,2,3,5] défini')"
)

